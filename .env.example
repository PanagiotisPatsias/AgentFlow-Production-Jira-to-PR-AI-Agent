# PostgreSQL container and application connections
POSTGRES_DB=agentflow
POSTGRES_USER=agentflow
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+psycopg://agentflow:change-this-local-password@127.0.0.1:5432/agentflow
LANGGRAPH_DATABASE_URL=postgresql://agentflow:change-this-local-password@127.0.0.1:5432/agentflow

# Celery broker and transient result backend
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Jira Cloud account
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=your-atlassian-account@example.com
JIRA_API_TOKEN=replace-with-an-atlassian-api-token
JIRA_CLOUD_ID=replace-with-your-cloud-id
JIRA_TICKET_KEY=SCRUM-1

# GitHub account and API
GITHUB_TOKEN=github_pat_replace_with_your_token
BASE_URL=https://api.github.com

# Model provider
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-5
OPENAI_TIMEOUT=30
OPENAI_IMPLEMENTATION_TIMEOUT=180

# Local Grafana login
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
